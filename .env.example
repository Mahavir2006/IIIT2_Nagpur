# ---------------------------------------------------------------------------
# BHUMI-NITI environment placeholders. Copy to .env for local development.
# NEVER commit .env (secrets) to Git. Only VITE_* vars reach the browser.
# ---------------------------------------------------------------------------

# Demo mode: "true" (default) prefers the bundled real OSM extract for the
# Gujarat demo corridor and degrades gracefully offline. Set "false" to force
# live parcel fetching everywhere.
VITE_DEMO_MODE=true

# Sentinel-2 mosaic year for the EOX cloudless layer (2024 or 2023).
VITE_SENTINEL_YEAR=2024

# Optional live parcel API base URL. Defaults to the app's own
# GET /api/parcels?bbox=… route (serves imported cadastral datasets from
# src/data/cadastral with bbox + village/surveyNumber/parcelId filters).
# Point this at a PostGIS-backed service for production scale.
VITE_PARCEL_API_URL=

# --- Server-side only (authenticated Copernicus path) ----------------------
# These must live in backend runtime env, NEVER in frontend code or .env
# committed to Git. The client stub in sentinelService.ts throws until a
# backend proxy route (Frontend -> Backend -> Copernicus) provides imagery.
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

# --- Server-side only (land-intelligence agent) -----------------------------
# OPENROUTER_API_KEY powers POST /api/ai (the Ask Bhumi prompt layer):
# OpenRouter chat completions with the show_area / submit_answer tool loop.
# Read ONLY in src/server/ai-agent.ts — never referenced from client code.
# vite.config.ts loads .env into process.env for `vite dev` / `vite build`;
# on deployed edge/workers, bind it as a plain env secret instead.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Server-side only (spoken replies) --------------------------------------
# ELEVENLABS_API_KEY powers POST /api/tts, which voices the Ask Bhumi answers
# on the / route. Read ONLY in src/server/tts.ts. If it is missing or
# ElevenLabs fails, the page falls back to the browser's speechSynthesis voice.
ELEVENLABS_API_KEY=
# Optional: voice and model (defaults match voice-agejt).
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Server-side only (policy document reader) ------------------------------
# GEMINI_API_KEY powers POST /api/policy/extract, which reads an uploaded policy
# PDF and returns its quantified provisions as structured JSON — each with the
# section, page and verbatim quote it came from. The PDF is sent to Google Gemini
# and is not stored; nothing else about the Policy Lab leaves the browser.
# Read ONLY in src/server/policy-extract.ts — never referenced from client code.
# vite.config.ts loads .env into process.env for `vite dev` / `vite build`;
# on deployed edge/workers, bind it as a plain env secret instead.
GEMINI_API_KEY=
# gemini-flash-latest tracks the current stable flash model, so this keeps
# working when Google retires a version. Pinned alternatives verified against a
# live key: gemini-3.8-flash, gemini-3.6-flash, gemini-3.1-flash-lite.
# Do NOT use gemini-2.5-flash / gemini-2.5-pro here: a fresh key gets a 404
# "no longer available to new users" for those.
GEMINI_MODEL=gemini-flash-latest

# --- Server-side only (PRAVAAH routing) --------------------------------------
# TomTom is optional. Never use VITE_TOMTOM_API_KEY: VITE_* values are public.
TOMTOM_API_KEY=
# Optional self-hosted OSRM-compatible server. Defaults to the public OSRM demo
# endpoint. The demo route returns road-network duration, not live traffic.
OSRM_BASE_URL=
# Optional auth gate for the local PRAVAAH backend. Set a strong secret in prod.
PRAVAAH_API_KEY=
PRAVAAH_DATA_DIR=./data
